#![no_std]
#![no_main]

use aya_ebpf::{
    bindings::xdp_action,
    macros::{map, xdp},
    maps::Array,
    programs::XdpContext,
};

use aya_log_ebpf::info;
use core::mem;

#[repr(C)]
struct EthHdr {
    dst: [u8; 6],
    src: [u8; 6],
    ethertype: u16,
}

#[repr(C)]
struct Ipv4Hdr {
    version_ihl: u8,
    tos: u8,
    tot_len: u16,
    id: u16,
    frag_off: u16,
    ttl: u8,
    protocol: u8,
    checksum: u16,
    saddr: u32,
    daddr: u32,
}

#[map]
static PACKET_COUNTER: Array<u64> = Array::<u64>::with_max_entries(1, 0);

#[xdp]
pub fn xdp_packet_intercept(ctx: XdpContext) -> u32 {
    match try_xdp_packet_intercept(ctx) {
        Ok(ret) => ret,
        Err(_) => xdp_action::XDP_PASS,
    }
}

fn try_xdp_packet_intercept(ctx: XdpContext) -> Result<u32, ()> {
    let data = ctx.data();
    let data_end = ctx.data_end();

    // Check Ethernet header
    if data + mem::size_of::<EthHdr>() > data_end {
        return Ok(xdp_action::XDP_PASS);
    }

    let eth = unsafe { &*(data as *const EthHdr) };

    // Count packets
    unsafe {
        if let Some(counter) = PACKET_COUNTER.get_ptr_mut(0) {
            *counter += 1;
        }
    }

    // IPv4 EtherType = 0x0800
    if u16::from_be(eth.ethertype) == 0x0800 {
        let ip_ptr = data + mem::size_of::<EthHdr>();

        if ip_ptr + mem::size_of::<Ipv4Hdr>() > data_end {
            return Ok(xdp_action::XDP_PASS);
        }

        let ip = unsafe { &*(ip_ptr as *const Ipv4Hdr) };

        info!(
            &ctx,
            "IPv4 src={} dst={} proto={}",
            u32::from_be(ip.saddr),
            u32::from_be(ip.daddr),
            ip.protocol
        );
    }

    Ok(xdp_action::XDP_PASS)
}

#[panic_handler]
fn panic(_: &core::panic::PanicInfo) -> ! {
    core::hint::unreachable_unchecked()
}
